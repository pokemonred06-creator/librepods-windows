;/*++
;Module Name:
;    LibreAAP.inf
;
;Abstract:
;    INF file for installing the LibreAAP Bluetooth L2CAP bridge driver for Apple AirPods
;
;    devcon.exe install LibreAAP.inf BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}
;
;--*/

[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%ProviderString%
DriverVer=10/28/2026,1.0.0.0
CatalogFile=LibreAAP.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
LibreAAP.sys  = 1,,

;*****************************************
; LibreAAP Install Section
;*****************************************

[Manufacturer]
%ManufacturerString%=LibreAAP,NTamd64.10.0.1..16299

[LibreAAP.NTamd64.10.0.1..16299]
%LibreAAP.DeviceDesc% = LibreAAP_Inst,BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}

[LibreAAP_Inst.NT]
CopyFiles=DriverStore_Dir

[DriverStore_Dir]
LibreAAP.sys

;-------------- Service installation
[LibreAAP_Inst.NT.Services]
AddService = LibreAAP,%SPSVCINST_ASSOCSERVICE%, LibreAAP_Service_Inst

; -------------- LibreAAP driver install sections
[LibreAAP_Service_Inst]
DisplayName    = %LibreAAP.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START 
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\LibreAAP.sys

[LibreAAP_Inst.NT.Wdf]
KmdfService =  LibreAAP, LibreAAP_Inst_wdfsect

[LibreAAP_Inst_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ProviderString = "LibrePods Project"
ManufacturerString = "LibrePods Project"
DiskId1 = "LibreAAP Installation Disk"
LibreAAP.DeviceDesc = "LibreAAP Bluetooth Driver for AirPods"
LibreAAP.SVCDESC = "LibreAAP Bluetooth L2CAP Bridge Driver"
